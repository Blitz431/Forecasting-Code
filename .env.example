# Alpaca API (https://app.alpaca.markets/)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key

# Trading mode: paper or live (NEVER set to live without understanding the risks)
TRADING_MODE=paper

# ML model integrity signing key (HMAC-SHA256)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ML_MODEL_SECRET=

# Phase 11 — Alerts (optional — configure the channels you want to use)
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Deep-research agent (page 22 / "Research suppliers") — local services, override only if non-default.
# Ollama LLM endpoint (default http://localhost:11434). OLLAMA_MODEL empty ⇒ first installed model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# SearXNG search endpoint (default http://localhost:8080). Enable JSON format in its settings.yml,
# or the agent falls back to scraping the HTML results page.
SEARX_BASE_URL=http://localhost:8080
